{
  "name": "firm-management-system",
  "productName": "Firm Management System",
  "version": "1.0.0",
  "private": true,
  "description": "A central inventory and sales management system.",
  "author": {
    "name": "Ronit Debnath",
    "email": "ronitdebnath047@gmail.com"
  },
  "type": "module",
  "main": "electron.js",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npx electron .\"",
    
    "electron:build": "vite build && electron-builder"
  },

  "build": {
    "appId": "com.decowood.firm-management-system",
    "productName": "Firm Management System",
    "copyright": "Copyright © 2025 ${author}",
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js"
    ],
    
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },

  "dependencies": {
    "crypto-js": "^4.2.0",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.1.7",
    "pocketbase": "^0.21.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.3",
    "xlsx": "^0.18.5"
  },
  
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  }
}